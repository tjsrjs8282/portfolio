---
// Words are split here, at build time, so the scroll-lit paragraph needs no
// runtime text splitting and reads as one normal sentence to screen readers.
const LINES: { t: string; em?: boolean }[] = [
  { t: "만들고 끝이 아니라," },
  { t: "실제 사용자가 쓰고 결제가 일어나는 제품까지.", em: true },
  { t: "거니웍스(GEONY WORKS) 대표 유선건입니다. 아이디어 한 줄을 기획부터 수익화까지" },
  { t: "끝까지", em: true },
  { t: "끌고 갑니다. 그 전 과정을" },
  { t: "AI 에이전트 하네스", em: true },
  { t: "— 서브에이전트 · 스킬 · MCP · 워크플로 — 위에서 돌립니다." },
];

const FACTS = [
  {
    k: "GEONY WORKS",
    v: "웹 · 앱 · 게임 개발 스튜디오. 기획 · 브랜딩 · UI/UX부터 로그인 · 결제 연동, 서버 · 배포, SEO까지 한 번에.",
  },
  {
    k: "실사용자 · 수익화",
    v: "Google Play에 출시해 인앱 결제를 붙인 RPG, 실제 고객 결제가 들어오는 청첩장 서비스. 출시 뒤 운영까지 직접.",
  },
  {
    k: "Harness Engineering",
    v: "저장소마다 규칙(CLAUDE.md · AGENTS.md)과 인계 문서(HANDOFF.md), 검증 게이트를 깔고 일을 맡깁니다.",
  },
  {
    k: "한국어 · Tiếng Việt",
    v: "제품 대부분을 두 언어로 설계합니다. 베트남어가 한국어보다 평균 2.9배 길다는 것까지 레이아웃 규칙에.",
  },
];
---

<section class="manifesto section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <h2 class="eyebrow mono" id="about-title">About · 유선건</h2>
    <p class="manifesto__text" data-words>
      {
        LINES.map((seg) => {
          const words = seg.t.split(" ");
          const spans = words.map((w) => <span class="mw">{w} </span>);
          return seg.em ? <em>{spans}</em> : spans;
        })
      }
    </p>

    <dl class="facts">
      {
        FACTS.map((f, i) => (
          <div class="fact" data-reveal style={`--d:${i}`}>
            <dt class="mono">
              <span class="fact__n">0{i + 1}</span>
              <span>{f.k.split(/(Tiếng Việt)/).map((part) => (part === "Tiếng Việt" ? <span lang="vi">{part}</span> : part))}</span>
            </dt>
            <dd>{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .manifesto {
    padding-top: clamp(80px, 12vw, 180px);
  }
  .manifesto__text {
    margin-top: 28px;
    font-size: clamp(28px, 4.6vw, 72px);
    font-weight: 800;
    line-height: 1.22;
    letter-spacing: -0.05em;
    max-width: 18em;
  }
  .manifesto__text em {
    font-style: normal;
    background: var(--grad-hot);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* Unlit words stay at 3.8:1 — dim, but still readable large text (WCAG AA). */
  :global(html.js-motion) .manifesto__text > .mw {
    color: #6b6b74;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(64px, 9vw, 128px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--line);
  }
  .fact {
    padding: 28px 24px 32px;
    background: var(--bg);
  }
  .fact dt {
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    margin-bottom: 14px;
  }
  .fact__n {
    color: var(--hot);
  }
  .fact dd {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
