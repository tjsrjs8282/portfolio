---
import { Picture } from "astro:assets";
import { OLD_WORKS, REMASTERS } from "../data/site";
import hollow2020 from "../assets/archive/hollow-2020.jpg";
import hollow2026 from "../assets/archive/hollow-2026.jpg";
import zini2020 from "../assets/archive/zini-2020.jpg";
import zini2026 from "../assets/archive/zini-2026.jpg";
import portfolio2020 from "../assets/archive/portfolio-2020.jpg";
// The 2020 mock-ups ship from legacy/ as they always did; here they get optimised copies.
import knives from "../../legacy/img/work2.png";
import oculus from "../../legacy/img/work4.png";
import musa from "../../legacy/img/work5.png";
import hankuk from "../../legacy/img/work6.png";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const THUMBS = { knives, oculus, musa, hankuk } as const;
// 2020 / 2026 screenshots for each remaster's before/after slider.
const IMAGES = {
  hk: { before: hollow2020, after: hollow2026 },
  zini: { before: zini2020, after: zini2026 },
} as const;
---

<section class="archive section" id="archive" aria-labelledby="archive-title">
  <div class="wrap">
    <div class="archive__head">
      <div>
        <p class="eyebrow mono">Archive · 2020 → 2026</p>
        <h2 class="h-section" id="archive-title">Then <span class="hot-text" aria-hidden="true">→</span><span class="sr-only">그리고</span> Now</h2>
      </div>
      <p class="lede">2020년, 처음 만든 작업들. 그리고 지금의 도구로 처음부터 다시 지은 것들.</p>
    </div>

    {
      REMASTERS.map((r, i) => (
        <article class:list={["remaster", { "remaster--flip": i % 2 === 1 }]} aria-labelledby={`${r.id}-title`}>
          <div class="compare" data-compare style="--pos: 50%">
            <div class="compare__img compare__img--after">
              <Picture
                src={IMAGES[r.id].after}
                alt={r.alt}
                formats={["avif", "webp"]}
                widths={[640, 1024, 1440]}
                sizes="(max-width: 900px) 92vw, 62vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="compare__img compare__img--before" aria-hidden="true">
              <Picture src={IMAGES[r.id].before} alt="" formats={["avif", "webp"]} widths={[640, 800]} sizes="(max-width: 900px) 92vw, 62vw" loading="lazy" decoding="async" />
            </div>
            <span class="compare__tag compare__tag--l mono" aria-hidden="true">2020 · jQuery</span>
            <span class="compare__tag compare__tag--r mono" aria-hidden="true">2026 · Astro</span>
            <span class="compare__handle" aria-hidden="true"><i>⟷</i></span>
            <label class="sr-only" for={`compare-${r.id}`}>{r.title} 2020년 원본과 2026년 리마스터 비교 — 왼쪽은 2020년, 오른쪽은 2026년</label>
            <input class="compare__range" id={`compare-${r.id}`} type="range" min="0" max="100" value="50" data-compare-range data-cursor="Drag" />
          </div>

          <div class="remaster__meta">
            <p class="mono remaster__kicker">{r.kicker}</p>
            <h3 class="remaster__title" id={`${r.id}-title`}>
              {r.title} <span>Remastered</span>
            </h3>
            <p class="remaster__body">{r.body}</p>
            <ul class="remaster__stack" role="list">
              {r.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
            <div class="remaster__links">
              {r.links.map((l, j) =>
                j === 0 ? (
                  <a class="btn btn--ghost" href={l.href} data-magnetic>
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a class="text-link" href={l.href}>
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ),
              )}
            </div>
          </div>
        </article>
      ))
    }

    <div class="then">
      <a class="legacy" href={`${base}legacy/`} data-cursor="2020">
        <div class="legacy__img">
          <Picture
            src={portfolio2020}
            alt="2020년 포트폴리오의 Work 화면 — 흰 배경 위 Hollow Knight 기기 목업과 PREV · NEXT 버튼"
            formats={["avif", "webp"]}
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) 92vw, 40vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="legacy__text">
          <p class="mono legacy__kicker">This site · 2020</p>
          <p class="legacy__title">이 사이트도 다시 지었습니다</p>
          <p class="legacy__body">jQuery 한 장짜리 2020년 포트폴리오 — 마우스를 따라오는 눈, 사운드 버튼까지 그대로 남겨 두었습니다.</p>
          <span class="legacy__cta">2020 버전 그대로 보기 <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <ul class="olds" role="list" aria-label="2020년 작업">
        {
          OLD_WORKS.map((w) => (
            <li>
              <a class="old" href={w.href} data-cursor="Open">
                <div class="old__img">
                  <Picture
                    src={THUMBS[w.id]}
                    alt=""
                    formats={["avif", "webp"]}
                    widths={[360, 640]}
                    sizes="(max-width: 700px) 46vw, 20vw"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="old__title">
                  {w.title} <span class="mono">{w.year}</span>
                </p>
                <p class="old__note">{w.note}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .archive__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .archive__head .h-section {
    margin-top: 18px;
  }

  .remaster {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    margin-top: clamp(48px, 6vw, 88px);
  }
  .remaster + .remaster {
    margin-top: clamp(64px, 8vw, 120px);
  }
  /* Every other remaster puts the slider on the right. */
  .remaster--flip {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }
  .remaster--flip .compare {
    order: 2;
  }

  .compare {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: #000;
    box-shadow: 0 40px 120px -30px rgb(0 0 0 / 0.8);
    user-select: none;
    touch-action: pan-y;
  }
  .compare__img {
    position: absolute;
    inset: 0;
  }
  .compare__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .compare__img--before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .compare__img--before :global(img) {
    filter: saturate(1.05) contrast(1.02);
  }
  .compare__tag {
    position: absolute;
    top: 14px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgb(7 7 11 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--text);
    pointer-events: none;
  }
  .compare__tag--l {
    left: 14px;
  }
  .compare__tag--r {
    right: 14px;
    color: var(--hot-3);
  }
  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--text);
    pointer-events: none;
    box-shadow: 0 0 24px rgb(255 255 255 / 0.5);
  }
  .compare__handle i {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-style: normal;
    font-weight: 700;
    transform: translate(-50%, -50%);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
  }
  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
  }
  .compare:has(.compare__range:focus-visible) {
    outline: 2px solid var(--hot-3);
    outline-offset: 4px;
  }

  .remaster__kicker {
    color: var(--hot);
  }
  .remaster__title {
    margin-top: 14px;
    font-size: clamp(30px, 3vw, 44px);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }
  .remaster__title span {
    display: block;
    font-family: var(--display);
    font-size: 0.5em;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
    font-variation-settings: "wdth" 120;
  }
  .remaster__body {
    margin-top: 18px;
    color: var(--muted);
    line-height: 1.8;
  }
  .remaster__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 20px 0 0;
  }
  .remaster__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 26px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 5px;
    transition: color 0.25s var(--ease);
  }
  .text-link:hover {
    color: var(--text);
  }

  .then {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(64px, 8vw, 120px);
  }
  .legacy {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--panel);
    overflow: hidden;
    transition:
      border-color 0.35s var(--ease),
      transform 0.5s var(--ease);
  }
  .legacy:hover {
    border-color: var(--line-2);
  }
  .legacy__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #fff;
  }
  .legacy__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .legacy:hover .legacy__img :global(img) {
    transform: scale(1.04);
  }
  .legacy__text {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px 26px 28px;
  }
  .legacy__kicker {
    color: var(--dim);
  }
  .legacy__title {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.05em;
  }
  .legacy__body {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }
  .legacy__cta {
    margin-top: 8px;
    font-weight: 700;
    color: var(--hot-3);
  }

  .olds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
    margin: 0;
  }
  .old {
    display: grid;
    gap: 8px;
    padding: 14px 14px 18px;
    border-radius: 18px;
    border: 1px solid var(--line);
    transition:
      border-color 0.35s var(--ease),
      background-color 0.35s var(--ease);
  }
  .old:hover {
    border-color: var(--line-2);
    background: var(--panel);
  }
  .old__img {
    aspect-ratio: 1600 / 972;
    border-radius: 10px;
    overflow: hidden;
    background: radial-gradient(60% 60% at 50% 40%, #1d1e2b, #0c0c13);
  }
  .old__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s var(--ease);
  }
  .old:hover .old__img :global(img) {
    transform: scale(1.05);
  }
  .old__title {
    margin-top: 6px;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .old__title .mono {
    margin-left: 6px;
    color: var(--dim);
    font-size: 11px;
  }
  .old__note {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 1000px) {
    .remaster,
    .then {
      grid-template-columns: 1fr;
    }
    .remaster--flip .compare {
      order: 0;
    }
  }
  @media (max-width: 480px) {
    .olds {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .old {
      padding: 10px 10px 14px;
    }
    .old__note {
      display: none;
    }
  }
</style>
