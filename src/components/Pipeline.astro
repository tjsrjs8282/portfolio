---
import { PIPELINE } from "../data/site";
---

<section class="pipe" id="pipeline" aria-labelledby="pipe-title" data-pipe>
  <div class="pipe__pin" data-pipe-pin>
    <div class="pipe__head wrap">
      <div>
        <p class="eyebrow mono">Process · 6 steps</p>
        <h2 class="h-section" id="pipe-title">Idea <span class="hot-text" aria-hidden="true">→</span><span class="sr-only">에서</span> Revenue</h2>
      </div>
      <p class="lede">
        기획 → 디자인 → 개발 → 배포 → 실사용자 → 수익화. 한 사람이 처음부터 끝까지, 단계마다 실제로 쓰는 도구와 남는 결과물이 있습니다.
      </p>
    </div>

    <div class="pipe__viewport" data-pipe-viewport>
      <ol class="pipe__track" role="list" data-pipe-track>
        {
          PIPELINE.map((s, i) => (
            <li class="stage" data-stage-card>
              <div class="stage__top">
                <span class="stage__num" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="mono stage__en">{s.en}</span>
              </div>
              <h3 class="stage__ko">
                <span class="sr-only">{i + 1}단계 </span>
                {s.ko}
              </h3>
              <p class="stage__title">{s.title}</p>
              <p class="stage__body">{s.body}</p>
              <ul class="stage__proof" role="list">
                {s.proof.map((p) => (
                  <li class="chip">{p}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <div class="pipe__wire" aria-hidden="true">
        <span class="pipe__wire-fill" data-pipe-bar></span>
      </div>
    </div>
  </div>
</section>

<style>
  .pipe {
    position: relative;
    padding-block: clamp(80px, 10vw, 140px) clamp(40px, 6vw, 80px);
  }
  .pipe__pin {
    position: relative;
  }
  .pipe__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .pipe__head .h-section {
    margin-top: 18px;
  }

  .pipe__viewport {
    position: relative;
    overflow: clip;
  }
  .pipe__track {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0 var(--gutter);
    width: max-content;
    will-change: transform;
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    width: clamp(300px, 30vw, 440px);
    min-height: clamp(420px, 52vh, 520px);
    padding: 28px 28px 30px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(255 91 31 / 0.08), transparent 55%),
      var(--panel);
    transition:
      border-color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .stage:hover {
    border-color: rgb(255 91 31 / 0.45);
  }
  .stage__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .stage__num {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(64px, 7vw, 104px);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(245 242 234 / 0.35);
    font-variation-settings: "wdth" 70;
  }
  .stage:hover .stage__num {
    -webkit-text-stroke-color: var(--hot);
  }
  .stage__en {
    color: var(--hot);
    padding-top: 6px;
  }
  .stage__ko {
    margin-top: auto;
    padding-top: 40px;
    font-size: clamp(34px, 3.4vw, 52px);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }
  .stage__title {
    margin-top: 10px;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.03em;
  }
  .stage__body {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .stage__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
  }

  .pipe__wire {
    position: relative;
    height: 2px;
    margin: 36px var(--gutter) 0;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .pipe__wire-fill {
    position: absolute;
    inset: 0;
    background: var(--grad-hot);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* Horizontal only where there is room and motion; otherwise a calm stack. */
  @media (max-width: 899px) {
    .pipe__track {
      flex-direction: column;
      width: auto;
    }
    .stage {
      width: auto;
      min-height: 0;
    }
    .stage__ko {
      padding-top: 24px;
    }
    .pipe__wire {
      display: none;
    }
  }
  /* No pin without motion or JS: the six steps sit in a plain grid. */
  :global(html.reduce-motion) .pipe__track,
  :global(html.no-js) .pipe__track {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    width: auto;
  }
  :global(html.reduce-motion) .stage,
  :global(html.no-js) .stage {
    width: auto;
  }
  :global(html.reduce-motion) .pipe__wire,
  :global(html.no-js) .pipe__wire {
    display: none;
  }
</style>
