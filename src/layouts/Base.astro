---
import { Font } from "astro:assets";
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.jpg`, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonical}#person`,
      name: SITE.name,
      alternateName: SITE.nameEn,
      jobTitle: "대표 · Full-stack Harness Engineer",
      worksFor: { "@id": `${canonical}#org` },
      url: canonical.href,
      sameAs: [SITE.links.github, SITE.links.blog, SITE.links.company],
    },
    {
      "@type": "Organization",
      "@id": `${canonical}#org`,
      name: SITE.companyEn,
      alternateName: SITE.company,
      url: SITE.links.company,
      founder: { "@id": `${canonical}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="ko" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#07070b" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={`${SITE.name} · ${SITE.companyEn}`} />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={`${SITE.name} · ${SITE.companyEn}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FULL-STACK HARNESS ENGINEERING — 유선건 · GEONY WORKS 대표" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Before first paint: flag JS and pick the motion mode, so CSS can set
      // initial animation states without ever hiding content from no-JS visits.
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        d.classList.add("js");
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        d.classList.add(reduce ? "reduce-motion" : "js-motion");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
